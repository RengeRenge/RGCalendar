<?xml version="1.0" encoding="utf-8"?>
<!-- 把卡片的内缩直接画进背景，而不是依赖 layout_margin：
     有些桌面在渲染 RemoteViews 时会忽略子视图的边距，导致卡片一直铺满整个格子。
     内缩量按真机像素实测校准，华为「日历」服务卡片是 429x429px（铺满它自己的格子），
     我们的槽位更大，用内缩把卡片收到同样大小、四边与它对齐。

     数值放在 dimens 里按屏幕状态分档（折叠态 values/、展开态 values-sw600dp/）：
     折叠和展开时桌面槽位几何不同，一套常数对不上，但结构只有这一份，值由系统自动选。 -->
<inset xmlns:android="http://schemas.android.com/apk/res/android"
    android:drawable="@drawable/widget_bg"
    android:insetLeft="@dimen/widget_card_inset_left"
    android:insetRight="@dimen/widget_card_inset_right"
    android:insetTop="@dimen/widget_card_inset_top"
    android:insetBottom="@dimen/widget_card_inset_bottom" />